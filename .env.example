# Wajib: kunci OpenRouter. Hanya dibaca di sisi server.
OPENROUTER_API_KEY=

# Identitas aplikasi di dashboard OpenRouter (opsional).
SITE_URL=https://somat.rominur.com
SITE_NAME=Somat

# Model. Nama-nama ini tidak pernah dikirim ke browser (opsional, ada nilai bawaan).
TEXT_MODEL=google/gemini-3.7-flash
VISION_MODEL=google/gemini-3.7-flash
IMAGE_MODEL=google/gemini-2.5-flash-image

# Penelusuran web oleh model (opsional). Isi "off" untuk mematikan.
WEB_SEARCH_ENABLED=on
WEB_SEARCH_MAX_USES=3
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_TOTAL=12

# Batas pemakaian karena situs terbuka tanpa login (opsional).
CHAT_BURST_LIMIT=20
CHAT_BURST_WINDOW_SEC=300
CHAT_DAILY_LIMIT=300
IMAGE_BURST_LIMIT=5
IMAGE_BURST_WINDOW_SEC=600
IMAGE_DAILY_LIMIT=20
IMAGE_GLOBAL_DAILY_LIMIT=100
MAX_OUTPUT_TOKENS=8192
MAX_UPLOAD_BYTES=12582912
MAX_UPLOAD_FILES=5

# Opsional: Upstash Redis REST supaya kuota tetap akurat lintas instance serverless.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
